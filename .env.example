# Copy to .env. Never commit .env.
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_URL=http://localhost:8000/webhook/github

# Configurable Gemini model. The original synopsis named Gemini 1.5 Pro.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2

CHROMADB_PATH=./chromadb_data
CHROMADB_COLLECTION_PREFIX=pr_copilot
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=6
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200

MAX_DIFF_SIZE_MB=5
MAX_FILES_PER_REVIEW=200
MAX_INLINE_COMMENTS=30
ENABLE_SECURITY_AGENT=true
ENABLE_PERFORMANCE_AGENT=true
ENABLE_ARCHITECTURE_AGENT=true

# COMMENT or REQUEST_CHANGES
REVIEW_EVENT=COMMENT
ALLOW_REQUEST_CHANGES=true

DATABASE_PATH=./data/pr_copilot.db
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO
